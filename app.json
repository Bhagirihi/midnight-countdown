{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F11",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.adayaway.app"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.adayaway.app",
      "supportsTablet": true
    },
    "name": "A Day Away",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F11",
          "image": "./assets/icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MidnightSmall",
              "displayName": "A Day Away — Small",
              "description": "Big D-number and title for your pinned countdown.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "./src/widgets/MidnightSmall.tsx"
              },
              "android": {
                "targetCellWidth": 1,
                "targetCellHeight": 1,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "./src/widgets/MidnightSmall.tsx"
              }
            },
            {
              "name": "MidnightMedium",
              "displayName": "A Day Away — Medium",
              "description": "D-number, title and next date for your pinned countdown.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/MidnightMedium.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 180,
                "minHeight": 110,
                "initialLayout": "./src/widgets/MidnightMedium.tsx"
              }
            },
            {
              "name": "MidnightLarge",
              "displayName": "A Day Away — Large",
              "description": "Pinned countdown with next milestone, next story date and next event.",
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/MidnightLarge.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 180,
                "initialLayout": "./src/widgets/MidnightLarge.tsx"
              }
            },
            {
              "name": "MidnightNextUp",
              "displayName": "A Day Away — Next up",
              "description": "Your next three upcoming events with their D-numbers.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/MidnightNextUp.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 320,
                "minHeight": 180,
                "initialLayout": "./src/widgets/MidnightNextUp.tsx"
              }
            },
            {
              "name": "MidnightYearDots",
              "displayName": "A Day Away — Year dots",
              "description": "One dot per day of the year: bright dots are the days still left, plus the year and days left.",
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/MidnightYearDots.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 180,
                "initialLayout": "./src/widgets/MidnightYearDots.tsx"
              }
            },
            {
              "name": "MidnightYearLock",
              "displayName": "A Day Away — Year left",
              "description": "Days left in the year with percent completed — a Lock Screen widget on iPhone, a compact home widget on Android.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/MidnightYearLock.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 180,
                "minHeight": 110,
                "initialLayout": "./src/widgets/MidnightYearLock.tsx"
              }
            }
          ]
        }
      ],
      "expo-sharing"
    ],
    "scheme": "a-day-away",
    "slug": "a-day-away",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
